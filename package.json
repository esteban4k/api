{
  "name": "pedalverde-api",
  "version": "1.0.0",
  "description": "API REST de un sistema de bicicletas compartidas: estaciones, préstamos, devoluciones y sanciones, con consola web y colección de Postman.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "postman": "npx --yes newman run postman/PedalVerde.postman_collection.json -e postman/PedalVerde.local.postman_environment.json"
  },
  "keywords": [
    "api-rest",
    "express",
    "postman",
    "bicicletas",
    "movilidad"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^5.1.0"
  }
}
